{
  "name": "swfl-stormguard-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env.local --watch server/index.js",
    "start:server": "node --env-file-if-exists=.env.local server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/backend/*.test.js tests/frontend/*.test.js tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:targeted": "node --test tests/backend/services.test.js tests/backend/uploads.test.js tests/frontend/components.test.js tests/integration/api.test.js",
    "test:render": "vite build --ssr tests/integration/render-check.jsx --outDir node_modules/.cache/stormguard-render && node node_modules/.cache/stormguard-render/render-check.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
