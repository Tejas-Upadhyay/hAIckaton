# Server only. Copy to .env.local; never use VITE_ for secrets.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Verified image input + structured output metadata on November 2, 2026.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional alternative: set AI_PROVIDER=gemini to use these values.
GEMINI_API_KEY=
# Vision + structured output; confirm access and quota in your API project.
GEMINI_MODEL=gemini-3.8-flash
PORT=8787
